# workshops.nina-ai.nl — Apache-instellingen voor Hostnet
#
# Dit bestand staat in workshops/public/ en komt bij `npm run build` mee in
# out/. Upload het dus gewoon met de rest mee; let er alleen op dat je
# FTP-programma verborgen bestanden toont, anders slaat het dit bestand over.
#
# Wat hier NIET in hoort: rewrites om URL's te laten werken. De site wordt
# geëxporteerd met trailingSlash, dus elke pagina is al een echte map met een
# index.html erin en Apache vindt hem vanzelf.

# --------------------------------------------------------------------------
# Altijd https, altijd zonder www
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://workshops.nina-ai.nl%{REQUEST_URI} [L,R=301]

  # www.workshops -> workshops
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://workshops.nina-ai.nl%{REQUEST_URI} [L,R=301]
</IfModule>

# --------------------------------------------------------------------------
# Onze eigen 404 in plaats van die van Apache
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Geen mappen laten doorbladeren
# --------------------------------------------------------------------------
Options -Indexes

# --------------------------------------------------------------------------
# Caching
#
# Alles onder /_next/static/ heeft een hash in de bestandsnaam en verandert
# nooit meer; dat mag een jaar in de cache. HTML juist niet: die moet bij een
# nieuwe upload direct de nieuwe versie tonen, anders zie je een gewijzigde
# datum pas een week later.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basale beveiligingsheaders. Geen strenge Content-Security-Policy: die zou
  # eerst getest moeten worden tegen Stripe en Google Tag Manager, en een
  # foute CSP breekt de betaalknop.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --------------------------------------------------------------------------
# Compressie
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Mimetypes die op oudere Apache-configuraties ontbreken
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType text/calendar .ics
</IfModule>
