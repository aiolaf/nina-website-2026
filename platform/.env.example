# Anthropic API key voor alle AI-stappen (haalbaarheidscheck + demo runner).
# Vraag deze aan bij console.anthropic.com. Kopieer dit bestand naar `.env`.
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: overschrijf het model. Default is claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optioneel: poort van de Express-backend (default 8787).
# De Vite-frontend proxyt /api hierheen.
PORT=8787
